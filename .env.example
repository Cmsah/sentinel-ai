# ============================================================
# Sentinel AI — Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=sentinel-ai
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_ECHO=false

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=sentinel-ai

# --- AI / LLM (leave blank to use simulation mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

# --- External Services (simulation mode by default) ---
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# --- Kubernetes (for real cluster access) ---
KUBE_CONFIG_PATH=
KUBE_NAMESPACE=default
